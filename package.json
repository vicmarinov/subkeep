{
  "name": "subkeep",
  "description": "SubKeep: Subscription Tracker",
  "author": "Victor Marinov",
  "homepage": "https://github.com/vicmarinov/subkeep#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vicmarinov/subkeep.git"
  },
  "bugs": {
    "url": "https://github.com/vicmarinov/subkeep/issues"
  },
  "license": "MIT",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "update-types": "set -a; [ -f .env ] && source .env; [ -f .env.local ] && source .env.local; set +a; supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" > src/types/database.types.ts"
  },
  "dependencies": {
    "@react-native-vector-icons/get-image": "^14.0.0",
    "@react-native-vector-icons/material-icons": "^14.0.0",
    "@react-navigation/bottom-tabs": "7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "@supabase/supabase-js": "^2.119.2",
    "expo": "~58.0.26",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-screens": "~4.30.1",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "supabase": "^3.2.0",
    "typescript": "~6.0.3"
  }
}
